# deploy/grid.env.example  -> /srv/grid/grid.env (0600, owner nick)
COLONY_URL=http://127.0.0.1:8787
COLONY_SLUG=colony-one
MIND_AGENT_ID=grid-colony-one
MIND_DATA_DIR=/srv/grid/colony-one/memory
ODIN_QUEUE=/srv/grid/colony-one/state/operator
ODIN_POLL_S=1
VERDICTS_DIR=/srv/grid/colony-one/verdicts
MIND_MODEL_ALIAS=agent-brain
# Deadline for one mind ask (relay and chronicle). A local CPU model such as
# kannaka-brain on debain2 needs ~2 min per Odin prompt; 400 leaves headroom.
MIND_ASK_TIMEOUT_S=180
# How long the relay waits before re-asking after a mind timeout/error. Keep it
# >= MIND_ASK_TIMEOUT_S on a CPU model: the daemon is still computing the orphaned
# answer, and an earlier retry queues behind it and times out again.
ODIN_RETRY_S=60
KANNAKA_BIN=/home/nick/.local/bin/kannaka
NATS_URL=nats://swarm.ninja-portal.com:4222
# NATS_USER / NATS_PASSWORD come from /home/nick/.kannaka-nats.env
# FLUX_URL=http://<flux host>:3000     # unset = skip Flux
STATE_EVERY_S=60
HISTORY_EVERY_S=60
