# deploy/grid.env.example  -> /srv/grid/grid.env (0600, owner nick)
COLONY_URL=http://127.0.0.1:8787
COLONY_SLUG=colony-one
MIND_AGENT_ID=grid-colony-one
MIND_DATA_DIR=/srv/grid/colony-one/memory
ODIN_QUEUE=/srv/grid/colony-one/state/operator
ODIN_POLL_S=1
VERDICTS_DIR=/srv/grid/colony-one/verdicts
MIND_MODEL_ALIAS=agent-brain
# Deadline for one mind ask (relay and chronicle). A local CPU model such as
# kannaka-brain on debain2 needs ~2 min per Odin prompt; 400 leaves headroom.
MIND_ASK_TIMEOUT_S=180
# How long the relay waits before re-asking after a mind timeout/error. Keep it
# >= MIND_ASK_TIMEOUT_S on a CPU model: the daemon is still computing the orphaned
# answer, and an earlier retry queues behind it and times out again.
# 900 with a CPU model on the direct route (see README §1a). Never put a comment on
# a VALUE line: systemd keeps it in the value and float("60  # ...") kills the relay.
ODIN_RETRY_S=60
# Relay asks go straight to this OpenAI-compatible endpoint when all three are
# set (set-mind-model.sh writes them); recall and remember stay on the daemon.
# Unset = asks go through `kannaka swarm serve`, which cannot survive a model
# that takes longer than ~4 min (it stops answering NATS pings and is dropped).
#MIND_LLM_URL=http://10.30.0.30:4000/v1
#MIND_LLM_MODEL=kannaka-brain
#MIND_LLM_KEY_FILE=/srv/grid/colony-one/mind-llm.key
KANNAKA_BIN=/home/nick/.local/bin/kannaka
NATS_URL=nats://swarm.ninja-portal.com:4222
# NATS_USER / NATS_PASSWORD come from /home/nick/.kannaka-nats.env
# Unset = skip Flux.
# FLUX_URL=http://<flux host>:3000
STATE_EVERY_S=60
HISTORY_EVERY_S=60
# Weekly release gate (grid.weekly): probes the Rogue promotion on debain2, ledgers the
# decision to releases_dir/versions.jsonl, and moves the kannaka-brain-current alias.
DEBAIN2_HOST=debain2
RELEASES_DIR=/srv/grid/releases
#ROGUE_CURRENT_MODEL=/srv/rogue/current-model
#ROGUE_LEDGER=/srv/rogue/ledger.jsonl
#ROGUE_RUNS_DIR=/home/nick/.kannaka-corpus/runs
#CURRENT_ALIAS=kannaka-brain-current
#PROBE_TIMEOUT_S=900
# Identity probe = 10 questions x this many runs. On a CPU model each ask is
# ~1-2 min, so 3 runs (30 asks) keeps a release under ~1 h; raise for a stricter
# gate or a faster serving tier.
#IDENTITY_PROBE_RUNS=3
# Colony A/B testing: candidate model to A/B against the current release (empty = no A/B).
# Written by the release gate; set by hand to start a test run.
#MIND_LLM_CANDIDATE=
# Split weight for the A/B candidate: 0.2 = 20% of requests go to candidate, 80% to incumbent.
# Written by the release gate; the default is 0.2.
#MIND_AB_SPLIT=0.2
# Prompt A/B testing (deploy/README.md section 6). Which prompt variant from the registry
# (grid/data/prompt_variants.json) the relay serves. Blank or absent means the registry's own
# `default` entry, which is what the relay logs and what the gate counts the incumbent arm
# under; set it only once a release has promoted a different variant.
#MIND_PROMPT_VARIANT=
# The variant to A/B against the one above; blank or absent means no prompt A/B. Written by the
# release gate, or set by hand for a smoke test. It must name an entry the registry holds: the
# relay's loader fails closed, so an id it has never heard of takes grid-odin down at boot and
# keeps it down.
#MIND_PROMPT_CANDIDATE=
# Split weight for the prompt candidate, its own knob and deliberately not MIND_AB_SPLIT:
# widening a model rollout must not move the prompt bucket boundary and re-randomise which
# wording each request gets, mid-experiment. Strictly between 0 and 1; the default is 0.2.
#MIND_PROMPT_AB_SPLIT=0.2
