# Scripts that run on Linux hosts must never pick up CRLF from a Windows checkout.
*.sh text eol=lf
*.py text eol=lf
deploy/systemd/* text eol=lf
deploy/*.example text eol=lf
*.ps1 text eol=crlf

# Prompt-variant templates are integrity-checked against a sha256 recorded in
# grid/data/prompt_variants.json; a Windows checkout with core.autocrlf=true
# would otherwise rewrite them to CRLF and make the fail-closed loader raise
# VariantError for a line-ending change instead of a real edit. Recursive so a
# future template in a subdirectory (or with a non-.md extension) is covered
# too, not just today's flat *.md layout.
grid/data/prompts/** text eol=lf
grid/data/prompt_variants.json text eol=lf
